{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static site on Cloudflare Workers (assets) plus /download/* from R2. GitHub Pages keeps serving the
  // same files from `main` for the links baked into shipped app builds; this is the copy the custom
  // domain will point at.
  "name": "pane-site",
  // pane.video is registered in this Cloudflare account; custom domains create the DNS and certificate.
  "routes": [
    { "pattern": "pane.video", "custom_domain": true },
    { "pattern": "www.pane.video", "custom_domain": true }
  ],
  // Keep the workers.dev URL alive: wrangler turns it off once routes exist, and app builds up to 17 link
  // to pane-site.jiranjan03.workers.dev. The Worker redirects that host to pane.video.
  "workers_dev": true,
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // The Worker runs before the asset lookup so the host redirect applies to every path.
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "r2_buckets": [{ "binding": "DOWNLOADS", "bucket_name": "pane-downloads" }],
  // PostHog (EU) project token, the public one the app ships with: counts page views and DMG downloads
  // (no cookie, a random id per event); empty turns it off.
  "vars": {
    "POSTHOG_HOST": "https://eu.i.posthog.com",
    "POSTHOG_KEY": "phc_mTGwESoaf72rUGsdoTo4dXPu6E7PDNEjhUk7nZVZXXdX"
  }
}
