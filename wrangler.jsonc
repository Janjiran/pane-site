{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static site on Cloudflare Workers (assets) plus /download/* from R2. GitHub Pages keeps serving the
  // same files from `main` for the links baked into shipped app builds; this is the copy the custom
  // domain will point at.
  "name": "pane-site",
  // pane.video is registered in this Cloudflare account; custom domains create the DNS and certificate.
  "routes": [
    { "pattern": "pane.video", "custom_domain": true },
    { "pattern": "www.pane.video", "custom_domain": true }
  ],
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "r2_buckets": [{ "binding": "DOWNLOADS", "bucket_name": "pane-downloads" }]
}
