{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static site on Cloudflare Workers (assets only). GitHub Pages keeps serving the same files from
  // `main` for the links baked into shipped app builds; this is the copy the custom domain will point at.
  "name": "pane-site",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": ".", "html_handling": "auto-trailing-slash", "not_found_handling": "404-page" }
}
